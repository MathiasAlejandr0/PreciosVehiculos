{
  "buildCommand": "npm run build",
  "outputDirectory": "web/dist",
  "framework": null,
  "rewrites": [
    { "source": "/((?!api/|data/|assets/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, s-maxage=120, stale-while-revalidate=600" }]
    }
  ]
}
