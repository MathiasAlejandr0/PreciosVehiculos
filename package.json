{
  "name": "precioauto",
  "version": "1.0.0",
  "private": true,
  "description": "Suite de inteligencia de mercado para vehículos usados en Chile",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm run server\" \"npm run web\"",
    "server": "node server/index.js",
    "web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node server/index.js",
    "crawl": "node server/crawl-cli.js",
    "snapshot": "node --input-type=module -e \"import { writeSnapshot } from './server/snapshot.js'; console.log(writeSnapshot());\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.12",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "tailwindcss": "^4.1.12",
    "vite": "^7.1.3"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
